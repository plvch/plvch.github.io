# Response headers for the Cloudflare Worker (wrangler.jsonc). Copied into dist/ by build.py.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# Hub assets are linked with a content hash (?v=…, build.py asset_url), so a changed
# file gets a new URL and browsers can keep these for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The workers.dev and PR preview hosts duplicate the site; keep them out of search results.
https://:name.:account.workers.dev/*
  X-Robots-Tag: noindex
